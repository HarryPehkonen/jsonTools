# Build directories. The pattern (not just "build/") covers the gate's own
# build-asan/ as well as any other CMake directory name.
build/
build-*/

# Local CI: the config is per-machine (see .ci.env.example); the logs are scratch.
# .ci/tidy-baseline.txt is NOT ignored if it is ever added — it would be the
# committed, shared bar for the tidy gate.
.ci.env
.ci-logs/

# Compiled artifacts
*.o
*.a

# Fuzzing (tools/ci.sh's fuzz stage). The harness binary and the corpus the gate
# accumulates live in build-fuzz/ (covered by build-*/ above), and the gate passes
# -artifact_prefix into that directory's corpus. A hand-run fuzzer, though, writes
# its corpus and its crash-*/leak-*/oom-*/timeout-* artifacts into the CURRENT
# directory — and an untracked, unignored file fails the tree stage.
fuzz_jt
corpus/
crash-*
leak-*
oom-*
timeout-*
