#!/usr/bin/env bash
#
# pre-push: the FULL tier — every stage, on the tree you are about to publish.
#
# TWO hooks, and the split is decided by a measurement rather than by intuition.
# .githooks/pre-commit runs the fast tier (`tree build tests`: 1 s when nothing has
# changed, ~3 s after a one-file edit), so every commit is a tree that builds and
# passes. This hook runs everything else. The full run is minutes — it builds from
# scratch twice — and that is exactly what had made committing look expensive; the
# 1-3 s commit tier is not a tax and it buys a bisectable history. Neither hook
# passes a stage list, so the default set inside tools/ci.sh stays the single
# definition of the gate.
#
# from AI-DEV-STARTER (plunk-in kit), templates/hooks/pre-push. Deviation: no stage list
# here, because the default set inside tools/ci.sh is the single definition of the gate and
# a list in this file would be a second copy of it (the kit's C++ template pins one; this
# repo's default set carries the project-shaped stages cli/fuzz/wire as well).
#
# Install as .githooks/pre-push and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# Requires a clean worktree, and ends with a pristine checkout of HEAD built from scratch —
# the check that catches "it works on my machine because of a file I never committed".
#
# Deliberate bypass when you need one:  git push --no-verify
#
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/tools/ci.sh" ]; then
    exec "$root/tools/ci.sh" --require-clean
fi

# No gate found is a failure, not a warning: a silently unarmed gate is worse than no
# gate, because it looks armed.
printf 'pre-push: no gate found. Expected %s/tools/ci.sh (C++).\n' "$root" >&2
exit 1
