# jsonTools pointer + argv tokens for libFuzzer.
# Terminals of the RFC 6901 pointer grammar and of the argparse surface every
# jt* tool shares. Syntax: name="literal"; \xNN escapes are allowed, so
# field_sep injects the NUL that separates the input's fields.
slash="/"
root="/"
slash_slash="//"
slash_trailing="/a/"
append="-"
tilde0="~0"
tilde1="~1"
tilde_bad="~2"
tilde_bare="~"
index0="0"
index1="1"
index2="2"
index9="9"
index_leading_zero="007"
index_negative="-1"
index_huge="99999999999999999999"
index_size_t_max="18446744073709551615"
index_over_size_t="18446744073709551616"
key_a="a"
key_b="b"
key_c="c"
key_list="list"
key_items="items"
key_name="name"
ptr_a="/a"
ptr_ab="/a/b"
ptr_abc="/a/b/c"
ptr_list="/a/list"
ptr_list_0="/a/list/0"
ptr_list_2="/a/list/2"
ptr_list_end="/a/list/3"
ptr_list_append="/a/list/-"
ptr_items="/items"
ptr_items_0="/items/0"
ptr_items_name="/items/0/name"
ptr_empty_key="/"
ptr_escaped_slash="/a~1b"
ptr_escaped_tilde="/a~0b"
ptr_scalar="/scalar"
ptr_null="/scalar/x"
field_sep="\x00"
open_obj="{"
close_obj="}"
open_arr="["
close_arr="]"
quote="\""
colon=":"
comma=","
null_lit="null"
true_lit="true"
num_lit="42"
str_lit="\"text\""
pretty="--pretty"
help_short="-h"
help_long="--help"
version="--version"
max_size="--max-size"
max_depth="--max-depth"
if_not_set="--if-not-set"
replace="--replace"
mkdir_p="-p"
plus_five="+5"
